{
  "schemaVersion": 1,
  "id": "zalith_vibe",
  "version": "${version}",
  "name": "Zalith Haptic Feedback",
  "description": "Native vibration feedback for Zalith Launcher on Android",
  "authors": ["ZalithVibe Team"],
  "license": "MIT",
  "environment": "client",
  "provides": [
    "touchcontroller"
  ],
  "entrypoints": {
    "client": [
      "com.zalith.vibe.ZalithVibeMod"
    ],
    "modmenu": [
      "com.zalith.vibe.gui.ModMenuApiImpl"
    ]
  },
  "mixins": [
    "zalith_vibe.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "*",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*"
  }
}
